# Backend
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
DATABASE_URL=jdbc:postgresql://localhost:5432/careerlens
DATABASE_USERNAME=careerlens
DATABASE_PASSWORD=replace-with-your-local-database-password
